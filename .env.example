# ─────────────────────────────────────────────────────────────────────────────
# .env.example — environment-variable reference for local development & Render.
#
# Copy to .env for local development:
#   cp .env.example .env
#
# For Render: set each variable in the Render Dashboard under
#   Environment → Environment Variables  (never commit real values).
#
# Variables prefixed VITE_ are embedded into the frontend bundle at build time.
# All other variables are server-side only and never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (build-time) ─────────────────────────────────────────────────────
# Must be set BEFORE `npm run build` runs — Render injects it automatically
# if you add it to Environment Variables before the first deploy.
VITE_GOOGLE_CLIENT_ID=

# ── Server-side secrets (runtime only — never exposed to the browser) ─────────

# Google OAuth 2.0 Client ID used for server-side token verification.
# Same value as VITE_GOOGLE_CLIENT_ID; kept separate to make the server-only
# usage explicit and auditable.
GOOGLE_CLIENT_ID=

# Neon PostgreSQL connection string.
# Format: postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT session signing secret — must be ≥ 32 characters.
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Telegram bot credentials (optional — leave blank to disable Telegram features).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Resend transactional email (optional — leave blank to disable email greeting).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Sridhar <your.email@example.com>

# ── Deployment URL ────────────────────────────────────────────────────────────
# Set to your Render service URL (no trailing slash).
# Example: https://portfolio-xxxx.onrender.com
# Used by: README instructions for OAuth origins and Telegram webhook setup.
APP_BASE_URL=https://portfolio-xxxx.onrender.com
